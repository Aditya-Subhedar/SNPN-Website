<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Society of Neuropeptides and Neuroendocrinology (SNPN)</title>
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

    <style>
       /* --- Nearest Event Banner Styles --- */
        .nearest-event-banner {
            margin-top: 20px;
            margin-bottom: 40px;
            background: var(--bg-light, #f8fafc);
            border-left: 4px solid var(--accent-brand, #2563EB);
            padding: 24px;
            border-radius: 0 8px 8px 0; /* Keeps the border side flat, rounds the right side */
            box-shadow: 0 4px 15px rgba(0,0,0,0.03);
            width: 100%; /* Forces exact alignment with the text above it */
            box-sizing: border-box; /* Prevents padding from breaking the width */
        }

        .event-badge {
            display: inline-block;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            color: var(--accent-brand, #2563EB);
            margin-bottom: 8px;
            letter-spacing: 0.8px;
        }

        .nearest-event-title {
            font-size: 17px;
            color: var(--primary-dark, #0A2F5D);
            margin: 0 0 8px 0;
            font-weight: 700;
            line-height: 1.4;
        }

        .nearest-event-date {
            font-size: 14px;
            color: var(--text-gray, #475569);
            margin: 0 0 15px 0; /* Added bottom margin to separate from the new button */
            display: flex;
            align-items: center;
        }

        .nearest-event-date i {
            margin-right: 8px;
            color: var(--accent-brand, #2563EB);
        }

        /* New secondary button for the banner */
        .event-banner-btn {
            display: inline-flex;
            align-items: center;
            font-size: 13px;
            font-weight: 600;
            color: var(--accent-brand, #2563EB);
            text-decoration: none;
            transition: color 0.2s ease;
        }

        .event-banner-btn i {
            margin-left: 6px;
            font-size: 12px;
            transition: transform 0.2s ease;
        }

        .event-banner-btn:hover {
            color: var(--primary-dark, #0A2F5D);
        }

        .event-banner-btn:hover i {
            transform: translateX(4px);
        }
    </style>
</head>
<body>
    <%- include('partials/header') %>

    <div class="hero-splitscreen">
        
        <div class="hero-content hero-left">
            <div class="hero-welcome-container">
                

                <!-- Dynamic Nearest Event Banner -->
                <% if (events && events.length > 0) { %>
                    <div class="nearest-event-banner">
                        <span class="event-badge">Next Upcoming Event</span>
                        <h3 class="nearest-event-title"><%= events[0].title %></h3>
                        <p class="nearest-event-date"><i class="fas fa-calendar-alt"></i> <%= events[0].date %></p>
                        
                        <!-- New Link to Events Page -->
                        <a href="/events" class="event-banner-btn">
                            View All Events <i class="fas fa-arrow-right"></i>
                        </a>
                    </div>
                <% } %>
                <h1 class="hero-title">Welcome</h1>
                <p class="hero-description">
                    Welcome to the Society for Neuropeptides and Neuroendocrinology (SNPN). We bring together scientists across India to drive cutting-edge research, share knowledge, and foster collaborations that advance the field of neuroendocrinology.
                </p>
                <a href="/about" class="hero-button">Read more about SNPN</a>
            </div>
        </div>

        <div class="hero-content hero-right">
            <div class="map-container">
                <h2 class="map-heading">Advancing Neuroendocrinology in India</h2>
                <img src="/images/india_map_stylized.png" alt="Map of India" class="hero-map-img">
            </div>
        </div>
        
    </div> 

    <div class="overlaid-cards-section">
        <div class="overlaid-cards-container">
            
            <div class="feature-card">
                <div class="card-icon"><i class="fas fa-users"></i></div>
                <h3 class="card-title">EXECUTIVE COUNCIL</h3>
                <p class="card-description">Meet our dedicated leadership team, guiding the society's scientific and strategic goals.</p>
                <a href="/council" class="card-button">Learn more</a>
            </div>

            <div class="feature-card">
                <div class="card-icon"><i class="fas fa-user-plus"></i></div>
                <h3 class="card-title">SOCIETY MEMBERSHIP</h3>
                <p class="card-description">Join our global network of experts and emerging scientists. Benefits include discounts, networking, and early access.</p>
                <a href="/membership" class="card-button">Learn more</a>
            </div>

            <div class="feature-card upcoming-events-card">
                <div class="card-icon"><i class="fas fa-calendar-alt"></i></div>
                <h3 class="card-title">UPCOMING EVENTS</h3>
                
                <div class="upcoming-events-list">
                    <% if (events && events.length > 0) { %>
                        <% events.forEach(event => { %>
                            <div class="event-item">
                                <h4 class="event-title"><%= event.title %></h4>
                                <p class="event-date"><%= event.date %></p>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <p class="no-events">No upcoming events listed.</p>
                    <% } %>
                </div>
                
                <a href="/events" class="card-button">Learn more</a>
            </div>

        </div> 
    </div> 

    <%- include('partials/footer') %>
</body>
</html>