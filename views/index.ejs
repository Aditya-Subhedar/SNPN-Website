<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Society of Neuropeptides and Neuroendocrinology (SNPN)</title>
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

    <style>
        /* --- Slideshow Interactive Enhancements --- */
        
        /* Ensure the frame acts as the absolute baseline for the arrow buttons */
        .slideshow-frame {
            position: relative;
            overflow: hidden;
        }

        /* Base Arrow Style */
        .slide-nav-btn {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            background: rgba(10, 47, 93, 0.6); /* Translucent theme dark blue */
            color: #ffffff;
            border: none;
            width: 45px;
            height: 45px;
            border-radius: 50%;
            cursor: pointer;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 16px;
            z-index: 20;
            opacity: 0; /* Hidden by default */
            transition: all 0.3s ease;
        }

        /* Position anchors */
        .prev-slide { left: 15px; }
        .next-slide { right: 15px; }

        /* Reveal navigation arrows cleanly on hover */
        .slideshow-frame:hover .slide-nav-btn {
            opacity: 1;
        }

        /* Hover states for the buttons themselves */
        .slide-nav-btn:hover {
            background: rgba(10, 47, 93, 0.95);
            color: #5bc0de; /* Matches your accent light blue tint */
            transform: translateY(-50%) scale(1.1);
        }
    </style>
</head>
<body>
    <%- include('partials/header') %>

    <div class="hero-splitscreen">
        
        <div class="hero-content hero-left">
            <div class="hero-welcome-container">
                <div class="slideshow-frame">
                    <img src="/images/Slideshow/ss1.png" class="slide active">
                    <img src="/images/Slideshow/ss2.png" class="slide">
                    <img src="/images/Slideshow/ss3.png" class="slide">
                    <img src="/images/Slideshow/ss4.png" class="slide">
                    <img src="/images/Slideshow/ss5.png" class="slide">
                    <img src="/images/Slideshow/ss6.png" class="slide">
                    <img src="/images/Slideshow/ss7.png" class="slide">
                    <img src="/images/Slideshow/ss8.png" class="slide">
                    <img src="/images/Slideshow/ss9.png" class="slide">
                    <img src="/images/Slideshow/ss10.png" class="slide">

                    <button class="slide-nav-btn prev-slide" aria-label="Previous Slide">
                        <i class="fas fa-chevron-left"></i>
                    </button>
                    <button class="slide-nav-btn next-slide" aria-label="Next Slide">
                        <i class="fas fa-chevron-right"></i>
                    </button>
                </div>

                <h1 class="hero-title">Welcome</h1>
                <p class="hero-description">
                    The Society of Neuropeptides and Neuroendocrinology (SNPN) welcomes you to explore 
                    contemporary research and foster connections in this vital scientific field. 
                    We aim to advance research in India through collaboration and excellence.
                </p>
                <a href="/about" class="hero-button">Read more about SNPN</a>
            </div>
        </div>

        <script>
            let currentSlide = 0;
            const slides = document.querySelectorAll('.slide');
            const slideshowFrame = document.querySelector('.slideshow-frame');
            const prevButton = document.querySelector('.prev-slide');
            const nextButton = document.querySelector('.next-slide');
            let rotationTimer;

            // Master display shifting engine
            function changeSlide(targetIndex) {
                // Strip visibility from current index
                slides[currentSlide].classList.remove('active');
                
                currentSlide = targetIndex;

                // Infinite loop validation bounds checks
                if (currentSlide >= slides.length) {
                    currentSlide = 0;
                } else if (currentSlide < 0) {
                    currentSlide = slides.length - 1;
                }

                // Add active class visibility to new item
                slides[currentSlide].classList.add('active');
            }

            // Automatic loop engine controllers
            function startIntervalLoop() {
                rotationTimer = setInterval(() => {
                    changeSlide(currentSlide + 1);
                }, 4000);
            }

            function stopIntervalLoop() {
                clearInterval(rotationTimer);
            }

            // Initialize on window loading sequence
            startIntervalLoop();

            /* --- Hover Event Listeners --- */
            slideshowFrame.addEventListener('mouseenter', stopIntervalLoop);
            slideshowFrame.addEventListener('mouseleave', startIntervalLoop);

            /* --- Click Event Listeners --- */
            nextButton.addEventListener('click', (event) => {
                event.stopPropagation(); // Prevents frame selection side-effects
                changeSlide(currentSlide + 1);
            });

            prevButton.addEventListener('click', (event) => {
                event.stopPropagation();
                changeSlide(currentSlide - 1);
            });
        </script>

        <div class="hero-content hero-right">
            <div class="map-container">
                <h2 class="map-heading">Advancing Neuroendocrinology in India</h2>
                <img src="/images/india_map_stylized.png" alt="Map of India" class="hero-map-img">
            </div>
        </div>
        
    </div> 

    <div class="overlaid-cards-section">
        <div class="overlaid-cards-container">
            
            <div class="feature-card">
                <div class="card-icon"><i class="fas fa-users"></i></div>
                <h3 class="card-title">EXECUTIVE COUNCIL</h3>
                <p class="card-description">Meet our dedicated leadership team, guiding the society's scientific and strategic goals.</p>
                <a href="/council" class="card-button">Learn more</a>
            </div>

            <div class="feature-card">
                <div class="card-icon"><i class="fas fa-user-plus"></i></div>
                <h3 class="card-title">SOCIETY MEMBERSHIP</h3>
                <p class="card-description">Join our global network of experts and emerging scientists. Benefits include discounts, networking, and early access.</p>
                <a href="/membership" class="card-button">Learn more</a>
            </div>

            <div class="feature-card upcoming-events-card">
                <div class="card-icon"><i class="fas fa-calendar-alt"></i></div>
                <h3 class="card-title">UPCOMING EVENTS</h3>
                
                <div class="upcoming-events-list">
                    <% if (events && events.length > 0) { %>
                        <% events.forEach(event => { %>
                            <div class="event-item">
                                <h4 class="event-title"><%= event.title %></h4>
                                <p class="event-date"><%= event.date %></p>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <p class="no-events">No upcoming events listed.</p>
                    <% } %>
                </div>
                
                <a href="/events" class="card-button">Learn more</a>
            </div>

        </div> 
    </div> 

    <%- include('partials/footer') %>
</body>
</html>