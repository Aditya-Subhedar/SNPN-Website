<header class="main-header">
    <div class="top-header">
        <div class="header-left">
            <img src="/images/logo.png" alt="SNPN Logo" class="site-logo">
        </div>
        <div class="header-right">
            <nav class="top-nav">
                <a href="/">Home</a>
                <a href="/about">About</a>
                <a href="/membership">Get Involved</a> <a href="/membership">Resources</a> 
            </nav>
            <div class="search-container">
                <input type="text" placeholder="Search the SNPN site">
                <button><i class="fas fa-search"></i></button> </div>
        </div>
    </div>
    
    <div class="bottom-header">
        <nav class="main-nav">
