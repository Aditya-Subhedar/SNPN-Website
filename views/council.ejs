<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Executive Council | SNPN</title>
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    
    <style>
        /* Page Header Design */
        .page-header {
            background-color: var(--primary-blue, #0A2F5D);
            color: var(--text-white, #ffffff);
            padding: 60px 10%;
            text-align: center;
            box-shadow: inset 0 -10px 20px rgba(0,0,0,0.1);
        }
        .page-header h1 {
            color: #ffffff;
            font-size: 38px;
            font-weight: 700;
            margin-bottom: 10px;
            letter-spacing: 1px;
        }
        .page-header p {
            color: var(--accent-blue, #CBD5E1);
            font-size: 16px;
            font-weight: 500;
        }

        /* Layout Container - Widened to support 5 columns */
        .council-container {
            max-width: 1450px; 
            margin: 60px auto;
            padding: 0 4%;
        }

        /* Flexbox Framework for 5 Items Per Row */
        .council-grid {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 25px; /* Slightly reduced gap to give cards more width */
            margin-bottom: 60px;
        }

        /* Uniform Card Component Styling */
        .council-card {
            /* Calculates width for 5 cards per row minus the 25px gap */
            width: calc(20% - 20px); 
            background-color: var(--bg-white, #ffffff);
            border-radius: 16px;
            padding: 30px 15px; 
            text-align: center;
            box-shadow: var(--card-shadow, 0 4px 20px -2px rgba(15, 23, 42, 0.08));
            border: 1px solid rgba(0,0,0,0.05);
            transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        
        .council-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.08);
        }

        /* Avatar Element Layout */
        .member-avatar-container {
            position: relative;
            margin-bottom: 18px;
        }

        .member-img {
            width: 110px; /* Scaled down slightly from 130px to fit 5-column proportions */
            height: 110px;
            border-radius: 50%;
            object-fit: cover;
            border: 4px solid var(--bg-light, #f8f9fa);
            box-shadow: 0 8px 20px rgba(0,0,0,0.06);
            transition: border-color 0.3s ease;
            background-color: #f8f9fa;
        }

        .council-card:hover .member-img {
            border-color: var(--accent-blue, #2563EB);
        }

        /* Card Text Structure */
        .member-name {
            color: var(--text-dark, #0F172A);
            font-size: 17px; /* Scaled down slightly to prevent awkward line breaks */
            font-weight: 700;
            margin-bottom: 6px;
            line-height: 1.3;
        }

        .member-role {
            color: var(--accent-blue, #2563EB);
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            margin-bottom: 10px;
        }

        .member-affiliation {
            color: var(--text-gray, #475569);
            font-size: 13px;
            line-height: 1.5;
            font-weight: 500;
        }

        /* Responsive Scaling */
        @media (max-width: 1200px) {
            .council-card {
                width: calc(33.333% - 17px); /* 3 per row on small laptops */
            }
        }

        @media (max-width: 850px) {
            .council-card {
                width: calc(50% - 13px); /* 2 per row on tablets */
            }
        }
        
        @media (max-width: 600px) {
            .council-card {
                width: 100%; /* 1 per row on phones */
            }
        }
    </style>
</head>
