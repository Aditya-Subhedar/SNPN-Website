<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Executive Council | SNPN</title>
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    
    <style>
        /* Page Header Design */
        .page-header {
            background-color: var(--primary-blue);
            color: var(--text-white);
            padding: 60px 10%;
            text-align: center;
            box-shadow: inset 0 -10px 20px rgba(0,0,0,0.1);
        }
        .page-header h1 {
            font-size: 38px;
            font-weight: 700;
            margin-bottom: 10px;
            letter-spacing: 1px;
        }
        .page-header p {
            color: var(--accent-blue);
            font-size: 16px;
            font-weight: 500;
        }

        /* Layout Container */
        .council-container {
            max-width: 1200px;
            margin: 60px auto;
            padding: 0 5%;
        }

        /* Section Typography */
        .council-section-title {
            color: var(--primary-blue);
            font-size: 26px;
            border-bottom: 3px solid var(--accent-blue);
            padding-bottom: 8px;
            margin-bottom: 40px;
            display: inline-block;
            font-weight: 700;
            letter-spacing: 0.5px;
        }

        /* Grid Frameworks - Updated to strictly hold 4 items per row */
        .office-bearers-grid, .executive-members-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 30px;
            margin-bottom: 60px;
        }

        /* Card Component Styling */
        .council-card {
            background-color: var(--bg-white);
            border-radius: 16px;
            padding: 35px 25px;
            text-align: center;
            box-shadow: var(--card-shadow);
            border: 1px solid rgba(0,0,0,0.03);
            transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        
        .council-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.08);
        }

        /* High-Level Card Emphasis (President) */
        .president-card {
            grid-column: 1 / -1; /* Spans all 4 columns */
            max-width: 450px;
            margin: 0 auto 40px auto;
            border-top: 4px solid var(--accent-blue);
        }

        /* Avatar Element Layout */
        .member-avatar-container {
            position: relative;
            margin-bottom: 20px;
        }

        .member-img {
            width: 130px;
            height: 130px;
            border-radius: 50%;
            object-fit: cover;
            border: 4px solid var(--bg-light);
            box-shadow: 0 8px 20px rgba(0,0,0,0.06);
            transition: border-color 0.3s ease;
            background-color: #f8f9fa; /* Background if image is transparent/loading */
        }

        .council-card:hover .member-img {
            border-color: var(--accent-blue);
        }

        /* Card Text Structure */
        .member-name {
            color: var(--text-dark);
            font-size: 19px;
            font-weight: 700;
            margin-bottom: 6px;
            line-height: 1.3;
        }

        .member-role {
            color: var(--accent-blue);
            font-size: 13px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            margin-bottom: 12px;
        }

        .member-affiliation {
            color: var(--text-gray);
            font-size: 14px;
            line-height: 1.5;
            font-weight: 400;
        }

        /* Responsive Optimization - Makes sure it scales down nicely on smaller screens */
        @media (max-width: 1024px) {
            .office-bearers-grid, .executive-members-grid {
                grid-template-columns: repeat(2, 1fr); /* 2 per row on tablets */
            }
        }
        
        @media (max-width: 600px) {
            .office-bearers-grid, .executive-members-grid {
                grid-template-columns: 1fr; /* 1 per row on phones */
            }
            .president-card {
                max-width: 100%;
            }
        }
    </style>
</head>
<body>
