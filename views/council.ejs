<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Executive Council | SNPN</title>
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    
    <style>
        /* Page Header Design */
        .page-header {
            background-color: var(--primary-blue, #0A2F5D);
            color: var(--text-white, #ffffff);
            padding: 60px 10%;
            text-align: center;
            box-shadow: inset 0 -10px 20px rgba(0,0,0,0.1);
        }
        .page-header h1 {
            color: #ffffff;
            font-size: 38px;
            font-weight: 700;
            margin-bottom: 10px;
            letter-spacing: 1px;
        }
        .page-header p {
            color: var(--accent-blue, #CBD5E1);
            font-size: 16px;
            font-weight: 500;
        }

        /* Layout Container */
        .council-container {
            max-width: 1300px; 
            margin: 60px auto;
            padding: 0 4%;
        }

        /* CSS Grid Framework for clean, responsive text cards */
        .council-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 30px; 
            margin-bottom: 60px;
        }

        /* Clean, Text-Only Professional Cards */
        .council-card {
            background-color: var(--bg-white, #ffffff);
            border-radius: 8px;
            padding: 30px 25px; 
            text-align: left;
            box-shadow: var(--card-shadow, 0 4px 15px rgba(15, 23, 42, 0.04));
            border: 1px solid rgba(0,0,0,0.06);
            border-top: 4px solid var(--accent-blue, #2563EB);
            transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);
            display: flex;
            flex-direction: column;
        }
        
        .council-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 15px 30px rgba(0,0,0,0.08);
            border-top-color: var(--primary-blue, #0A2F5D);
        }

        /* Card Text Structure */
        .member-role {
            color: var(--accent-blue, #2563EB);
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 8px;
        }

        .member-name {
            color: var(--text-dark, #0F172A);
            font-size: 20px; 
            font-weight: 700;
            margin-bottom: 12px;
            line-height: 1.2;
        }

        .member-affiliation {
            color: var(--text-gray, #475569);
            font-size: 14px;
            line-height: 1.6;
            font-weight: 500;
            margin-bottom: 25px;
            flex-grow: 1; /* Pushes the link to the bottom of the card */
        }

        /* Professional Link Styling */
        .member-link {
            display: inline-flex;
            align-items: center;
            font-size: 14px;
            font-weight: 600;
            color: var(--primary-blue, #0A2F5D);
            text-decoration: none;
            transition: color 0.2s ease;
            margin-top: auto;
        }

        .member-link i {
            margin-left: 6px;
            font-size: 12px;
            transition: transform 0.2s ease;
        }

        .member-link:hover {
            color: var(--accent-blue, #2563EB);
        }

        .member-link:hover i {
            transform: translateX(4px);
        }
    </style>
</head>
<body>
    <%- include('partials/header') %>

