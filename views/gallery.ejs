<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gallery | SNPN</title>
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="https://cloudflare.com">
    
    <style>
        /* --- Gallery Specific Styles --- */
        
        /* Hero Banner (Matches Theme) */
        .gallery-hero {
            background: linear-gradient(135deg, var(--primary-blue, #0A2F5D) 0%, #061e3e 100%);
            color: #ffffff;
            padding: 80px 8%;
            text-align: center;
            border-bottom: 4px solid var(--accent-blue, #5bc0de);
        }

        .gallery-hero h1 {
            font-size: 42px;
            margin-bottom: 15px;
            font-weight: 700;
        }

        .gallery-hero p {
            font-size: 18px;
            color: #cbd5e1;
            max-width: 700px;
            margin: 0 auto;
            line-height: 1.6;
        }

        /* Gallery Grid Section */
        .gallery-section {
            padding: 60px 8% 80px;
            background-color: var(--bg-light, #f8fafc);
            min-height: 50vh;
        }

        .gallery-filters {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 15px;
            margin-bottom: 40px;
            opacity: 0.6;
            pointer-events: none; /* Disables clicking filters while empty */
        }

        .filter-btn {
            padding: 8px 20px;
            background: transparent;
            border: 2px solid var(--primary-blue, #0A2F5D);
            color: var(--primary-blue, #0A2F5D);
            border-radius: 20px;
            font-weight: 600;
            font-size: 14px;
            cursor: default;
        }

        .filter-btn.active {
            background: var(--primary-blue, #0A2F5D);
            color: #ffffff;
        }

        /* Clean "Coming Soon" Box Styles */
        .gallery-soon-box {
            max-width: 650px;
            margin: 0 auto;
            background: #ffffff;
            border-radius: 12px;
            padding: 50px 40px;
            text-align: center;
            box-shadow: 0 10px 30px rgba(0,0,0,0.04);
            border: 1px solid #e2e8f0;
        }

        .gallery-soon-box i {
            font-size: 52px;
            color: var(--accent-blue, #5bc0de);
            margin-bottom: 22px;
        }

        .gallery-soon-box h4 {
            font-size: 24px;
            color: var(--primary-blue, #0A2F5D);
            margin: 0 0 12px 0;
            font-weight: 700;
        }

        .gallery-soon-box p {
            color: var(--text-gray, #64748b);
            font-size: 15px;
            line-height: 1.65;
            margin: 0;
        }
    </style>
</head>
<body>

    <%- include('partials/header') %>

    <section class="gallery-hero">
        <h1>Event Gallery</h1>
        <p>Explore moments from our past symposiums, workshops, and national neuroendocrinology networking events.</p>
    </section>

    <section class="gallery-section">
        
        <!-- Filters styled but safely grayed out and locked -->
        <div class="gallery-filters">
            <button class="filter-btn active">All Events</button>
            <button class="filter-btn">Annual Conferences</button>
            <button class="filter-btn">Workshops</button>
            <button class="filter-btn">Awards</button>
        </div>

        <!-- Clean professional announcement card instead of blank placeholders -->
        <div class="gallery-soon-box">
            <i class="fa-solid fa-images"></i>
            <h4>Media Gallery Launching Soon</h4>
            <p>Our official media catalog is currently being curated. High-resolution photographs, presentation snapshots, and award ceremony highlights from the upcoming 1st Annual Conference will be hosted here immediately following the event conclusion.</p>
        </div>
        
    </section>

    <%- include('partials/footer') %>

</body>
</html>
